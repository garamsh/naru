add table inet naru
delete table inet naru
table inet naru {
	set members {
		type ipv4_addr
		flags interval
		elements = { 10.1.0.3, 10.1.4.0/24, 10.2.0.3 }
	}
	chain input {
		type filter hook input priority 0; policy accept;
		ip saddr 10.1.0.0/16 ip daddr { 10.0.0.1, 192.0.2.1 } counter drop comment "a to the host"
		ip saddr 10.2.0.0/16 ip daddr { 10.0.0.1, 192.0.2.1 } counter drop comment "b to the host"
	}
	chain forward {
		type filter hook forward priority 0; policy drop;
		ct state established,related accept
		iifname "tap*" ip saddr != @members counter drop comment "forged source"
		ip saddr 172.16.0.0/24 ip daddr 10.1.0.2 accept comment "management to a's API endpoint"
		ip saddr 10.1.0.0/16 ip daddr { 10.2.0.0/16 } counter drop comment "a to another network"
		ip saddr 10.1.0.0/16 ip daddr 172.16.0.0/24 counter drop comment "a to management"
		ip saddr 10.1.0.0/16 ip daddr 10.1.0.0/16 accept comment "a inside its prefix"
		ip saddr 10.1.0.0/16 oifname "eth0" accept comment "a egress"
		ip saddr 10.2.0.0/16 ip daddr { 10.1.0.0/16 } counter drop comment "b to another network"
		ip saddr 10.2.0.0/16 ip daddr 172.16.0.0/24 counter drop comment "b to management"
		ip saddr 10.2.0.0/16 ip daddr 10.2.0.0/16 accept comment "b inside its prefix"
		ip saddr 10.2.0.0/16 oifname "eth0" accept comment "b egress"
	}
}
