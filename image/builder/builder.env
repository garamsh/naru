# The builder image (image/builder/Dockerfile) by the digest of its config, which names the content
# of every layer and does not depend on how a layer is compressed. image/builder/run.sh builds the
# image from the Dockerfile and fails unless the result has this digest, so two machines run the
# same toolchain. A change to the Dockerfile changes the digest: run.sh prints the new one, and the
# pull request that changes the Dockerfile carries it here.
BUILDER_CONFIG_DIGEST=sha256:ace58aed633deb7429a28c6d1006acd072398dbf08efa3f9b7c8e0e272223b7d
