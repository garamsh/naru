# The sources of the mkfs.xfs the image carries (ADR 0027): xfsprogs and the libraries it links, each
# pinned by URL and SHA-256 as the e2fsprogs source is (ADR 0011).
#
# xfsprogs 7.2.1 and util-linux 2.42 (libuuid and libblkid) come from kernel.org; each digest is the
# tarball's line in the PGP-signed sha256sums.asc beside it:
#   https://cdn.kernel.org/pub/linux/utils/fs/xfs/xfsprogs/sha256sums.asc
#   https://cdn.kernel.org/pub/linux/utils/util-linux/v2.42/sha256sums.asc
# userspace-rcu 0.15.7 comes from lttng.org; its digest is the one in the .sha256 file beside it,
# https://lttng.org/files/urcu/userspace-rcu-0.15.7.tar.bz2.sha256
# inih r62 is the GitHub archive of the upstream tag (https://github.com/benhoyt/inih/tree/r62); the
# project publishes no digest, so its digest is the one measured when the pin was made, and a
# changed archive fails the build.
# The version and the digest of each move together, in one pull request, which a reviewer checks
# against those files.
#
# Moved by: the PM, who reviews this pin when a stable release or a security advisory for one of
# the pinned sources is published. No bot proposes it.
XFSPROGS_VERSION=7.2.1
XFSPROGS_URL=https://cdn.kernel.org/pub/linux/utils/fs/xfs/xfsprogs/xfsprogs-7.2.1.tar.xz
XFSPROGS_SHA256=c45f5fd81fdebcdae61938fcfdff86c9960b39fc89a06df633730d93876cd27d
UTIL_LINUX_VERSION=2.42
UTIL_LINUX_URL=https://cdn.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.tar.xz
UTIL_LINUX_SHA256=3452b260bbaa775d6e749ac3bb22111785003fc1f444970025c8da26dfa758e9
URCU_VERSION=0.15.7
URCU_URL=https://lttng.org/files/urcu/userspace-rcu-0.15.7.tar.bz2
URCU_SHA256=2556b83adc0f9b3ac8024e613e17d014d04c4c49110604ce55fcb14eae32edd3
INIH_VERSION=r62
INIH_URL=https://github.com/benhoyt/inih/archive/refs/tags/r62.tar.gz
INIH_SHA256=9c15fa751bb8093d042dae1b9f125eb45198c32c6704cd5481ccde460d4f8151
