# The mount and umount programs the image carries, for the kubelet, which runs a mount executable to
# make the tmpfs-backed volumes of Secrets, ConfigMaps and projected volumes: util-linux 2.42.4 from
# kernel.org, the newest release of the 2.42 series on 2026-11-13 (published 2026-09-21). The digest
# is the tarball's line in the PGP-signed sha256sums.asc beside it,
# https://cdn.kernel.org/pub/linux/utils/util-linux/v2.42/sha256sums.asc; the version and the digest
# move together, in one pull request, which a reviewer checks against that file.
#
# Moved by: the PM, who reviews this pin when a stable util-linux release or a security advisory for
# the pinned one is published. No bot proposes it.
UTIL_LINUX_VERSION=2.42.4
UTIL_LINUX_URL=https://cdn.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.4.tar.xz
UTIL_LINUX_SHA256=fbd62a100ab7bb8746ba0661255c3c48185b1e9021507c624da01fbc696330ec
