# naru's host kernel configuration, merged over x86_64 defconfig. The initramfs carries no
# modules, so every driver the Node needs is built in. A line here that kconfig drops for an
# unmet dependency is caught by required.txt, which the build checks against the final .config.
# CONFIG_MODULES is not set
# CONFIG_WERROR is not set

# KVM, for mvmd's VMMs, on both CPU vendors
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_TUN=y
CONFIG_USERFAULTFD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# nftables with the netdev and inet families, connection tracking and NAT
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y

# fs-verity on ext4, for mvmd's state directory
CONFIG_EXT4_FS=y
CONFIG_FS_VERITY=y

# namespaces and cgroup v2 controllers, for the supervisors and VMM confinement
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# cpu.max, which mvmd writes to limit a VMM's CPU.
CONFIG_CFS_BANDWIDTH=y
# CONFIG_RT_GROUP_SCHED is not set

# Landlock
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y

# what QEMU and Proxmox present, and how init and the tooling reach the Node
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# The drives Proxmox attaches: a cloud-init CD-ROM on the q35 AHCI bus (ide2), disks on
# virtio-scsi-pci (scsi0, scsi1), and the NoCloud volume's file system. JOLIET reads the names
# genisoimage writes without Rock Ridge.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_IP_PNP=y

# Booting as an EFI executable from the ESP of the disk image (ADR 0007). The x86 stub reads
# initrd= from CONFIG_CMDLINE (drivers/firmware/efi/libstub/x86-stub.c) and loads that file from
# the volume the kernel was loaded from, so firmware passes no argument and loads no initrd.
# Documentation/admin-guide/efi-stub.rst: '/' in the path is read as '\'.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 panic=-1 loglevel=4 initrd=/INITRD.GZ"
