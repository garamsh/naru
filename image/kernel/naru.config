# naru's host kernel configuration, merged over x86_64 defconfig. The initramfs carries no
# modules, so every driver the Node needs is built in. A line here that kconfig drops for an
# unmet dependency is caught by required.txt, which the build checks against the final .config.
# CONFIG_MODULES is not set
# CONFIG_WERROR is not set

# KVM, for mvmd's VMMs, on both CPU vendors
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
CONFIG_TUN=y
CONFIG_USERFAULTFD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# nftables with the netdev and inet families, connection tracking and NAT
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_IPV4=y

# kube-proxy's nftables mode: the expressions its rules use beyond the ones above (random
# numbering and hashing for the endpoints of a Service, fib for local addresses, socket, limit,
# connlimit and redirect), the IPv6 reject, and bridged traffic passing the hooks (br_netfilter),
# so that a Pod reaches a Service through the bridge CNI plugin.
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_HASH=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VETH=y

# naru-hostd's ruleset (host/internal/network/ruleset.go) uses sets, interval sets, counters, ct
# state, the inet family, the input and forward hooks and iifname/oifname. All but ct and inet are
# built into nf_tables in Linux 6.18 and have no symbol of their own: the counter, meta, lookup,
# payload and cmp expressions, the set types (hash, bitmap, rbtree, pipapo) and the filter chain.
# NF_TABLES, NF_TABLES_INET and NFT_CT above are the symbols the ruleset leaves to choose.
# Its hosts reach each other over a WireGuard tunnel (ADR 0050). WIREGUARD selects the UDP tunnel
# and crypto code it needs.
CONFIG_WIREGUARD=y
CONFIG_WIREGUARD=y

# fs-verity on ext4, for mvmd's state directory
CONFIG_EXT4_FS=y
CONFIG_FS_VERITY=y

# The storage disk (ADR 0027): XFS with reflinks, whose online scrub stays off because the image
# carries no xfs_scrub; the device mapper with thin provisioning and snapshots, loop and NBD
# devices, which mvmd's disk backends use. Dependencies the kernel selects are listed in required.txt.
CONFIG_XFS_FS=y
# CONFIG_XFS_ONLINE_SCRUB is not set
CONFIG_BLK_DEV_DM=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_SNAPSHOT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_NBD=y

# namespaces and cgroup v2 controllers, for the supervisors and VMM confinement
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# cpu.max, which mvmd writes to limit a VMM's CPU.
CONFIG_CFS_BANDWIDTH=y
# CONFIG_RT_GROUP_SCHED is not set

# the kubelet's cgroup v2 controllers (cpuset, io, hugetlb, freezer), the device controller runc
# sets on a container (a BPF program, so BPF_SYSCALL), and what containerd, runc and a Pod's
# containers use: overlayfs for the snapshots, tmpfs and devpts, message queues, file handles and
# the keyring.
CONFIG_CPUSETS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_UNIX98_PTYS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FHANDLE=y
CONFIG_KEYS=y

# Landlock
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y

# what QEMU and Proxmox present, and how init and the tooling reach the Node
CONFIG_PCI=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# The drives Proxmox attaches: a cloud-init CD-ROM on the q35 AHCI bus (ide2), disks on
# virtio-scsi-pci (scsi0, scsi1), and the NoCloud volume's file system. JOLIET reads the names
# genisoimage writes without Rock Ridge.
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_VIRTIO=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_DEVTMPFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_IP_PNP=y

# Booting as an EFI executable from the ESP of the disk image (ADR 0020). The initramfs is inside
# the kernel (image/kernel/embed.sh sets CONFIG_INITRAMFS_SOURCE): the x86 stub concatenates every
# initrd= file it finds, in LoadOptions and then in CONFIG_CMDLINE, so a per-slot initrd could not
# be told from the other slot's, and one file per slot is what makes a slot a single rename.
# efivarfs is how the running system creates the trial boot entry and sets BootNext.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=ttyS0 panic=-1 loglevel=4"
