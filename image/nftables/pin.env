# The nft program the image carries, for kube-proxy's nftables mode (which runs it through
# knftables), built from the three netfilter.org release tarballs below: libmnl 1.0.5, libnftnl
# 1.3.2 and nftables 1.1.7, the newest release of each on 2026-11-13. Each digest is the tarball's
# line in the .sha256sum file netfilter.org publishes beside it, under
# https://www.netfilter.org/pub/<project>/; a version and its digest move together, in one pull
# request, which a reviewer checks against those files.
#
# kube-proxy reads nft's JSON output (`nft -j`), so nft is built with JSON, which needs jansson 2.15.1,
# the newest release on 2026-11-13; its digest is the one GitHub publishes for the release asset
# (the maintainers publish no checksum file) and matches the file as downloaded.
#
# Moved by: the PM, in a pull request that reruns `make image` and `make image-repro` and the QEMU
# test that starts a Pod, when a release of one of them is published that kube-proxy needs or an
# advisory is published for a pinned one. No bot proposes it.
LIBMNL_VERSION=1.0.5
LIBMNL_URL=https://www.netfilter.org/pub/libmnl/libmnl-1.0.5.tar.bz2
LIBMNL_SHA256=274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525
LIBNFTNL_VERSION=1.3.2
LIBNFTNL_URL=https://www.netfilter.org/pub/libnftnl/libnftnl-1.3.2.tar.xz
LIBNFTNL_SHA256=c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0
NFTABLES_VERSION=1.1.7
NFTABLES_URL=https://www.netfilter.org/pub/nftables/nftables-1.1.7.tar.xz
NFTABLES_SHA256=a6fbf060d8d4fff001517a2b94f356bb4366bfbf0ba366366f9d27cc38caa58f
JANSSON_VERSION=2.15.1
JANSSON_URL=https://github.com/akheron/jansson/releases/download/v2.15.1/jansson-2.15.1.tar.bz2
JANSSON_SHA256=f9aa4b3ec8496fee69db94f06f3d76fd4a26b012ee9bf1e917078c2cd2841881
