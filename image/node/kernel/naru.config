# The Node's own kernel as a microVM (ADR 0034): the host kernel's configuration, which
# image/common/kernel/kernel.sh merges first (base says so), so a guest Node holds what a host Node does for
# Kubernetes, and these changes for a VMM that boots a kernel directly rather than through UEFI.
#
# Firecracker and Cloud Hypervisor enter an uncompressed vmlinux at the PVH entry, with no firmware.
CONFIG_PVH=y
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
# Firecracker's devices sit on PCI (mvmd ADR 0059); virtio-mmio is for a VMM that lists its devices
# on the kernel's command line.
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
# No EFI executable, no efivarfs and no built-in command line: the kernel boots on the line mvmd
# gives it, which is the console and what init needs.
# CONFIG_EFIVAR_FS is not set
# CONFIG_EFI_STUB is not set
# CONFIG_EFI is not set
# CONFIG_CMDLINE_BOOL is not set
# The stop request: Firecracker sends Ctrl-Alt-Del through the i8042, Cloud Hypervisor the ACPI power
# button (mvmd ADR 0059).
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_ACPI_BUTTON=y
# WireGuard, for the overlay a later change brings (aurora#804).
CONFIG_WIREGUARD=y
