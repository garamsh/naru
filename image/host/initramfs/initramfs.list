# The initramfs, in the list format of the kernel's usr/gen_init_cpio: one entry per line, in the
# order they are archived. build.sh replaces @OUT@ with the directory holding the built programs.
# Every entry is owned by 0:0; the archive's mtimes are fixed by gen_init_cpio's -t.
# It also carries the Node runtime (Kubernetes, containerd, runc, the CNI plugins, etcd) for the boot
# disk's Node form (ADR 0007, 0031, 0054); the Node image's own list is image/node/initramfs/initramfs.list.
dir /bin 0755 0 0
dir /dev 0755 0 0
# The kernel's built-in initramfs, whose list has this node, is used only when none is embedded.
nod /dev/console 0600 0 0 c 5 1
dir /etc 0755 0 0
dir /etc/cni 0755 0 0
dir /etc/ssl 0755 0 0
dir /etc/ssl/certs 0755 0 0
dir /opt 0755 0 0
dir /opt/cni 0755 0 0
dir /opt/cni/bin 0755 0 0
dir /proc 0755 0 0
dir /run 0755 0 0
dir /sys 0755 0 0
dir /tmp 1777 0 0
dir /var 0755 0 0
dir /var/lib 0755 0 0
dir /var/lib/naru 0755 0 0
# The kubelet's device-plugin directory is /var/lib/kubelet in the kubelet's code, whatever --root-dir says.
slink /var/lib/kubelet /var/lib/naru/kubelet 0777 0 0
# The kubelet reads /etc/passwd and /etc/group for its user-namespace mappings; a Kubernetes Node's
# user-data writes them.
slink /etc/passwd /run/kubernetes/passwd 0777 0 0
slink /etc/group /run/kubernetes/group 0777 0 0
# containerd copies /etc/hosts into every Pod's sandbox; a Kubernetes Node's user-data writes it.
slink /etc/hosts /run/kubernetes/hosts 0777 0 0
# The kubelet makes /var/log/containers and /var/log/pods, and the root is read-only once init has set
# up: /var/log is /tmp, which is a tmpfs. The Pods' logs themselves are in the kubelet's podLogsDir.
slink /var/log /tmp 0777 0 0
# containerd makes a Pod's network namespace under /var/run/netns, where it keeps them by default.
slink /var/run /run 0777 0 0
# The CNI plugins keep their cached results and host-local its leases in /var/lib/cni; both are as
# short-lived as the Pods, which containerd keeps in /run, so they are in /run/cni, where the
# network configuration is.
slink /var/lib/cni /run/cni 0777 0 0
slink /etc/resolv.conf /run/naru/resolv.conf 0777 0 0
file /init @OUT@/naru-init 0755 0 0
file /bin/mvmd @OUT@/mvmd 0755 0 0
file /bin/mvmd-supervisor @OUT@/mvmd-supervisor 0755 0 0
file /bin/firecracker @OUT@/firecracker 0755 0 0
file /bin/mkfs.ext4 @OUT@/mkfs.ext4 0755 0 0
file /bin/mkfs.xfs @OUT@/mkfs.xfs 0755 0 0
file /bin/gaon-node-agent @OUT@/gaon-node-agent 0755 0 0
file /bin/gaon-apiserver @OUT@/gaon-apiserver 0755 0 0
file /bin/gaon-scheduler @OUT@/gaon-scheduler 0755 0 0
file /bin/gaon-controllers @OUT@/gaon-controllers 0755 0 0
file /bin/etcd @OUT@/etcd 0755 0 0
file /bin/docker-credential-ecr-login @OUT@/docker-credential-ecr-login 0755 0 0
file /bin/aws_signing_helper @OUT@/aws_signing_helper 0755 0 0
file /etc/ssl/certs/ca-certificates.crt @OUT@/ca-certificates.crt 0644 0 0
file /bin/naru-standin @OUT@/naru-standin 0755 0 0
file /bin/naru-vip @OUT@/naru-vip 0755 0 0
file /bin/naru-fence @OUT@/naru-fence 0755 0 0
file /bin/naru-hostd @OUT@/naru-hostd 0755 0 0
file /bin/kube-apiserver @OUT@/kube-apiserver 0755 0 0
file /bin/kube-controller-manager @OUT@/kube-controller-manager 0755 0 0
file /bin/kube-scheduler @OUT@/kube-scheduler 0755 0 0
file /bin/kubelet @OUT@/kubelet 0755 0 0
file /bin/kube-proxy @OUT@/kube-proxy 0755 0 0
file /bin/containerd @OUT@/containerd 0755 0 0
file /bin/containerd-shim-runc-v2 @OUT@/containerd-shim-runc-v2 0755 0 0
file /bin/runc @OUT@/runc 0755 0 0
file /bin/nft @OUT@/nft 0755 0 0
file /bin/mount @OUT@/mount 0755 0 0
file /bin/umount @OUT@/umount 0755 0 0
file /opt/cni/bin/bridge @OUT@/bridge 0755 0 0
file /opt/cni/bin/host-local @OUT@/host-local 0755 0 0
file /opt/cni/bin/loopback @OUT@/loopback 0755 0 0
