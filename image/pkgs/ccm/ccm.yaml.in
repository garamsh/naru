# The cloud-controller add-on (ADR 0085, 0093): naru-ccm, whose service controller gives a Service of type
# LoadBalancer an address from orch and whose node controller names each Node after its member. A control-plane
# Node applies it only when the cluster turns it on. The operator makes the Secret naru-ccm (cloud.conf, ca.crt,
# tls.crt and tls.key, from `naructl ccm credential`); no Node or orch does.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: cloud-controller-manager
  namespace: kube-system
  labels: {app.kubernetes.io/managed-by: naru-addons}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: naru:cloud-controller-manager
  labels: {app.kubernetes.io/managed-by: naru-addons}
rules:
- apiGroups: [""]
  resources: [events]
  verbs: [create, patch, update]
- apiGroups: [""]
  resources: [nodes]
  verbs: [get, list, watch, update, patch, delete]
- apiGroups: [""]
  resources: [nodes/status]
  verbs: [patch]
- apiGroups: [""]
  resources: [services]
  verbs: [get, list, watch, update, patch]
- apiGroups: [""]
  resources: [services/status]
  verbs: [patch, update]
- apiGroups: [coordination.k8s.io]
  resources: [leases]
  verbs: [create, get, list, update, watch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: naru:cloud-controller-manager
  labels: {app.kubernetes.io/managed-by: naru-addons}
roleRef: {apiGroup: rbac.authorization.k8s.io, kind: ClusterRole, name: naru:cloud-controller-manager}
subjects:
- {kind: ServiceAccount, name: cloud-controller-manager, namespace: kube-system}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: naru-ccm
  namespace: kube-system
  labels: {app.kubernetes.io/managed-by: naru-addons, k8s-app: naru-ccm}
spec:
  replicas: 2
  selector:
    matchLabels: {k8s-app: naru-ccm}
  template:
    metadata:
      labels: {k8s-app: naru-ccm}
    spec:
      serviceAccountName: cloud-controller-manager
      # The Secret's files are root:<fsGroup> 0440, so the unprivileged user 65532 reads them through its group.
      securityContext: {fsGroup: 65532}
      priorityClassName: system-cluster-critical
      # The Nodes are tainted until this controller initializes them, so it runs on the host network of a
      # control-plane Node, where no Pod network is needed, and tolerates that taint.
      hostNetwork: true
      dnsPolicy: Default
      nodeSelector: {node-role.kubernetes.io/control-plane: ""}
      tolerations:
      - {key: node.cloudprovider.kubernetes.io/uninitialized, operator: Exists, effect: NoSchedule}
      - {key: node-role.kubernetes.io/control-plane, operator: Exists, effect: NoSchedule}
      - {key: node.kubernetes.io/not-ready, operator: Exists, effect: NoSchedule}
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - topologyKey: kubernetes.io/hostname
            labelSelector:
              matchLabels: {k8s-app: naru-ccm}
      containers:
      - name: naru-ccm
        image: @CCM_IMAGE@
        imagePullPolicy: IfNotPresent
        args:
        - --cloud-provider=naru
        - --cloud-config=/etc/naru-ccm/cloud.conf
        - --leader-elect=true
        - --leader-elect-resource-namespace=kube-system
        - --use-service-account-credentials=false
        - --configure-cloud-routes=false
        - --allocate-node-cidrs=false
        - --secure-port=10258
        securityContext:
          allowPrivilegeEscalation: false
          capabilities: {drop: [ALL]}
          readOnlyRootFilesystem: true
          runAsNonRoot: true
          runAsUser: 65532
        volumeMounts:
        - {name: credential, mountPath: /etc/naru-ccm, readOnly: true}
      volumes:
      - name: credential
        secret:
          secretName: naru-ccm
          defaultMode: 0440
