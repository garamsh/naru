# libseccomp, which runc links (ADR 0026, 0075), built static from the release tarball below. The
# digest is the tarball's line in the SHA256SUM file the release publishes beside it,
# https://github.com/seccomp/libseccomp/releases/download/v2.6.1/libseccomp-2.6.1.tar.gz.SHA256SUM;
# the version and the digest move together, in one pull request, which a reviewer checks against
# that file.
#
# Moved by: the PM, in a pull request that reruns `make image` and the QEMU test that starts a Pod,
# when a release is at least two weeks old or an advisory is published for the pinned one. No bot
# proposes it.
LIBSECCOMP_VERSION=2.6.1
LIBSECCOMP_URL=https://github.com/seccomp/libseccomp/releases/download/v2.6.1/libseccomp-2.6.1.tar.gz
LIBSECCOMP_SHA256=501f66c667225d53791b97e1d7cf85ab764c297d04881f60f38f451c4b0ee1be
# libseccomp's build generates its syscall tables with gperf, which the host may not have, so
# the Dockerfile builds gperf from this release too. GNU publishes a detached signature and no digest
# file: the digest below is the tarball's, checked on 2026-11-13 against
# https://ftp.gnu.org/gnu/gperf/gperf-3.3.tar.gz.sig with GNU's keyring (Bruno Haible's key,
# E0FF BD97 5397 F77A 32AB 76EC B630 1D9E 1BBE AC08). The tool runs at build time only. The URL is
# GNU's mirror at kernel.org, which serves the same file: ftp.gnu.org timed out on 2026-11-15, from
# the workstation and from the builder. The digest is unchanged.
GPERF_VERSION=3.3
GPERF_URL=https://mirrors.kernel.org/gnu/gperf/gperf-3.3.tar.gz
GPERF_SHA256=fd87e0aba7e43ae054837afd6cd4db03a3f2693deb3619085e6ed9d8d9604ad8
