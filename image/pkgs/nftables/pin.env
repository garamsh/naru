# The nft program the image carries, for kube-proxy's nftables mode (which runs it through
# knftables): nftables 1.1.7 from netfilter.org, the newest release on 2026-11-13. Its digest is the
# tarball's line in the .sha256sum file netfilter.org publishes beside it, under
# https://www.netfilter.org/pub/nftables/. The libraries it links are the packages libmnl, libnftnl
# and jansson, each with its own pin. The version and the digest move together, in one pull
# request, which a reviewer checks against that file.
#
# Moved by: the PM, in a pull request that reruns `make image` and `make image-repro` and the QEMU
# test that starts a Pod, when a release is published that kube-proxy needs or an advisory is
# published for the pinned one. No bot proposes it.
NFTABLES_VERSION=1.1.7
NFTABLES_URL=https://www.netfilter.org/pub/nftables/nftables-1.1.7.tar.xz
NFTABLES_SHA256=a6fbf060d8d4fff001517a2b94f356bb4366bfbf0ba366366f9d27cc38caa58f
