# The jansson library nft links for its JSON output, which kube-proxy reads (`nft -j`): 2.15.1, the
# newest release on 2026-11-13; its digest is the one GitHub publishes for the release asset (the
# maintainers publish no checksum file) and matches the file as downloaded. The version and the
# digest move together, in one pull request.
#
# Moved by: the PM, in a pull request that reruns `make image` and `make image-repro` and the QEMU
# test that starts a Pod, when a release is published that kube-proxy needs or an advisory is
# published for the pinned one. No bot proposes it.
JANSSON_VERSION=2.15.1
JANSSON_URL=https://github.com/akheron/jansson/releases/download/v2.15.1/jansson-2.15.1.tar.bz2
JANSSON_SHA256=f9aa4b3ec8496fee69db94f06f3d76fd4a26b012ee9bf1e917078c2cd2841881
#
# Licences (SPDX), read from the COPYING or LICENSE of each source and checked by naru-release (ADR 0076).
JANSSON_LICENSE=MIT
