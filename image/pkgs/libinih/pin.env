# The inih library mkfs.xfs links (ADR 0027): r62, the GitHub archive of the upstream tag
# (https://github.com/benhoyt/inih/tree/r62). The project publishes no digest, so the digest is the
# one measured when the pin was made, and a changed archive fails the build. The version and the
# digest move together, in one pull request.
#
# Moved by: the PM, who reviews this pin when a stable release or a security advisory for it is
# published. No bot proposes it.
INIH_VERSION=r62
INIH_URL=https://github.com/benhoyt/inih/archive/refs/tags/r62.tar.gz
INIH_SHA256=9c15fa751bb8093d042dae1b9f125eb45198c32c6704cd5481ccde460d4f8151
