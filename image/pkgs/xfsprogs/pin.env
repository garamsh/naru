# The source of the mkfs.xfs the image carries (ADR 0027): xfsprogs 7.2.1 from kernel.org; its digest is
# the tarball's line in the PGP-signed sha256sums.asc beside it,
# https://cdn.kernel.org/pub/linux/utils/fs/xfs/xfsprogs/sha256sums.asc. The libraries it links are
# the packages util-linux (libuuid and libblkid), liburcu and libinih, each with its own pin. The
# version and the digest move together, in one pull request, which a reviewer checks against that file.
#
# Moved by: the PM, who reviews this pin when a stable release or a security advisory for it is
# published. No bot proposes it.
XFSPROGS_VERSION=7.2.1
XFSPROGS_URL=https://cdn.kernel.org/pub/linux/utils/fs/xfs/xfsprogs/xfsprogs-7.2.1.tar.xz
XFSPROGS_SHA256=c45f5fd81fdebcdae61938fcfdff86c9960b39fc89a06df633730d93876cd27d
#
# Licences (SPDX), read from the COPYING or LICENSE of each source and checked by naru-release (ADR 0076).
XFSPROGS_LICENSE='GPL-2.0-only AND LGPL-2.1-only'
