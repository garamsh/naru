# The mvmd the image carries: mvmd and mvmd-supervisor are built from a commit of the public
# repository, and so is the Firecracker fetch (`tooling/firecracker/fetch.sh --firecracker-only` in
# that checkout) that supplies the Firecracker binary alone. The commit is not written here: it is
# the one host/go.mod pins for the module MVMD_COMMIT_FROM names, which image/pkgs/mvmd-commit.sh
# reads and build.sh passes as MVMD_COMMIT, so the daemon and the client hostd is compiled against
# are one version.
#
# Moved by: the PM, in a pull request that moves the runtimeapi pin of host, tooling/qemu and
# tooling/probe to the new commit (mvmd-commit.sh fails unless the three agree), and the digests of
# image/pkgs/guest-initrds/pin.env with it. No bot proposes it.
MVMD_REPO=https://github.com/garamsh/mvmd
# The module whose version in host/go.mod names the commit.
MVMD_COMMIT_FROM=github.com/garamsh/mvmd/lib/runtimeapi
#
# Licences (SPDX), read from the COPYING or LICENSE of each source and checked by naru-release (ADR 0076).
MVMD_LICENSE=NOASSERTION
