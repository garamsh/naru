# The source of the mkfs.ext4 the image carries: e2fsprogs 1.47.4 from kernel.org (ADR 0011). The
# digest is the tarball's line in the PGP-signed sha256sums.asc beside it,
# https://cdn.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.4/sha256sums.asc; the
# version and the digest move together, in one pull request, which a reviewer checks against that
# file.
#
# Moved by: the PM, who reviews this pin when a stable e2fsprogs release or a security advisory for
# the pinned one is published. No bot proposes it.
E2FSPROGS_VERSION=1.47.4
E2FSPROGS_URL=https://cdn.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.4/e2fsprogs-1.47.4.tar.xz
E2FSPROGS_SHA256=fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b
