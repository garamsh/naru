# The Amazon ECR credential helper the image carries (ADR 0026): docker-credential-ecr-login,
# built from the commit that tag ecr-login/v0.12.0 of the public repository is. The commit, not
# the tag, is the pin: build.sh fetches that object and fails unless HEAD is it, and a tag can be
# moved. GO_TOOLCHAIN is the Go release the build runs with, so the bytes do not depend on the
# host's go command (a go command that is not that version downloads it).
#
# Moved by: the PM, in a pull request that reruns `make image` and `make image-repro`, when an
# advisory is published for the pinned release or aurora asks for a feature of a later one.
# No bot proposes it.
ECR_LOGIN_REPO=https://github.com/awslabs/amazon-ecr-credential-helper
ECR_LOGIN_VERSION=0.12.0
ECR_LOGIN_COMMIT=7ff7d6bd7a06408ddb9646c9ebccf97dbd190d55
GO_TOOLCHAIN=go1.26.11
