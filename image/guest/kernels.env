# The guest kernels a Node carries (ADR 0010), declared when the image is built. Each name is a
# directory of image/guest/kernels/ holding that kernel's naru.config and required.txt, and is the
# name in the image's guest.json. A name is 1 to 63 characters of [a-z0-9-], the form mvmd's
# `kernels` map takes (garamsh/mvmd#364). GUEST_DEFAULT_KERNEL is the one the Machines boot on
# until a Machine chooses another; it must be one of GUEST_KERNELS.
#
# Moved by: the PM, in a pull request that adds or removes a directory under kernels/.
GUEST_KERNELS="naru"
GUEST_DEFAULT_KERNEL=naru
# Where the image holds the guest files: kernels/<name>/vmlinux, guest-initrd.cpio,
# converter-initrd.cpio and guest.json under this directory (docs/architecture/image.md).
GUEST_IMAGE_DIR=/usr/lib/naru/guest
