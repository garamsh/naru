# naru's guest kernel, merged over x86_64 tinyconfig. A Machine boots it as an uncompressed ELF
# with a PVH entry, from the Guest Agent's initrd, which carries no modules, so every driver is
# built in. A line here that kconfig drops for an unmet dependency is caught by required.txt,
# which the build checks against the final .config.
# CONFIG_MODULES is not set
# CONFIG_WERROR is not set

# The processor and the VMM: PVH entry, KVM paravirtualisation, vCPUs the agent brings online.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_HOTPLUG_CPU=y
CONFIG_PVH=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_ACPI=y
CONFIG_X86_X2APIC=y

# What a user-space Rust program and a PID 1 need of the kernel.
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RANDOM_TRUST_CPU=y

# The initrd, and the files the agent reads and writes.
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y

# The file systems of a Machine: EROFS image under an overlay whose upper layer is an ext4 disk.
CONFIG_EXT4_FS=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y

# The virtio devices a VMM presents. The PCI bus carries the hot-plugged disks (Firecracker runs
# with --enable-pci); virtio-mmio is the other transport.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_ACPI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_VSOCKETS=y

# The one network device the agent configures, over rtnetlink.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y

# The kernel's own reseed after a restore (mvmd ADR 0016).
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
