# The identifiers of the disk image (ADR 0007). They are fixed so that the same kernel and initramfs
# give the same bytes; the two GUIDs were drawn once from /proc/sys/kernel/random/uuid. The FAT
# volume id and every timestamp in the volume come from SOURCE_DATE_EPOCH in image/build.env.
DISK_GUID=3dd7b437-488f-444b-b79c-39104e4f9f9f
ESP_GUID=cb4162e7-9d1e-48df-b937-f5792071b950
