# The public root bundle the image carries (ADR 0026), as /etc/ssl/certs/ca-certificates.crt: the
# Mozilla roots as curl publishes them, at the dated release below. The URL names the release and
# CACERT_SHA256 its digest; build.sh fails unless the download has it. The release date goes into the
# release notes (docs/architecture/image.md).
#
# Moved by: the PM, in a pull request that names the new release and its digest, when Mozilla
# distrusts or adds a root the Nodes need (a registry whose chain no longer verifies). No bot
# proposes it.
CACERT_DATE=2026-11-05
CACERT_URL=https://curl.se/ca/cacert-2026-11-05.pem
CACERT_SHA256=427c064216761a1e72a8b30f0d954d08cb6e4435a82091fb865afd20c8497285
