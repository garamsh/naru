# The environment every step of the image build runs in, so that the same inputs give the same
# bytes. SOURCE_DATE_EPOCH is 2026-11-11T00:00:00Z. The kernel build and gen_init_cpio read it;
# the KBUILD_BUILD_* names are the ones the kernel build stamps into the image.
export SOURCE_DATE_EPOCH=1794355200
export KBUILD_BUILD_TIMESTAMP='Wed Nov 11 00:00:00 UTC 2026'
export KBUILD_BUILD_USER=naru
export KBUILD_BUILD_HOST=naru
export KBUILD_BUILD_VERSION=1
export TZ=UTC
export LC_ALL=C
